{
  "name": "acp-pet",
  "version": "0.1.0",
  "description": "A desktop pet that acts out what your ACP coding agent is doing, live.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "demo": "npm run build && electron . --demo",
    "smoke": "npm run build && electron . --smoke",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pets:draw": "python scripts/pets/draw_twins_hd.py --preview && python scripts/pets/draw_twins.py --preview",
    "pets:install-codex": "node scripts/install-codex-pets.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "acpx": "0.19.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
